menu "AMLOGIC LCD Drivers"

config AML_LCD
	bool "lcd output for video"
	depends on AML_VOUT
	help
	  Support for lcd video output

config AML_LCD_DPI
	bool "DPI output for lcd"
	depends on AML_LCD
	help
	  Support for lcd DPI output (rgb, bt656, bt2020)
	  Disable to reduce size on chip without DPI

config AML_LCD_LVDS
	bool "LVDS output for lcd"
	depends on AML_LCD
	help
	  Support for lcd LVDS output
	  Disable to reduce size on chip without LVDS

config AML_LCD_VBYONE
	bool "V-BY-ONE output for lcd"
	depends on AML_LCD
	help
	  Support for lcd V-BY-ONE output

config AML_LCD_TCON
	bool "tcon output for lcd"
	depends on AML_LCD
	help
	  Support for lcd tcon output

config AML_LCD_MIPI_DSI
	bool "MIPI-DSI output for lcd"
	depends on AML_LCD
	help
	  Support for lcd MIPI-DSI output

source "drivers/amlogic/media/vout/lcd/lcd_parser/Kconfig"
source "drivers/amlogic/media/vout/lcd/lcd_extern/Kconfig"
source "drivers/amlogic/media/vout/lcd/backlight/Kconfig"

endmenu
